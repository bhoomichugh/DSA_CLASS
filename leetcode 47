class Solution {
    void reverse(int nums[],int lo,int hi){
        while(lo<=hi){
            swap(nums,lo,hi);
            lo++;
            hi--;
        }
    }
    void swap(int nums[],int lo,int hi){
            int temp=nums[lo];
            nums[lo]=nums[hi];
            nums[hi]=temp;
    }

    
    public List<List<Integer>> permuteUnique(int[] nums) {
        Arrays.sort(nums);//sorting the array to get the minimum permutation
        
        int n=nums.length;

        List<List<Integer>> ans=new ArrayList<>();

        while(true){
            List<Integer> list=new ArrayList<>();
            for(int i=0;i<n;i++)list.add(nums[i]);

            ans.add(list);


            //finding the first break point
            
            int ind=-1;
            for(int i=n-2;i>=0;i--){
                if(nums[i]<nums[i+1]){
                    ind=i;
                    break;
                }
            }

            //if no index is found then it means that we have reached the last permutation
            if(ind==-1)break;
            
            //finding the eleemnt just greater than nums[ind]
            int in=-1;
            for(int i=n-1;i>=ind+1;i--){
                if(nums[i]>nums[ind]){
                    in=i;
                    break;
                }
            }
            swap(nums,in,ind);

            reverse(nums,ind+1,n-1);
            
        }

        return ans;
        
    }
}
